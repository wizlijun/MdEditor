{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "note.md",
  "mainBinaryName": "notemd",
  "version": "6.905.6",
  "identifier": "net.notemd.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "note.md",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "resources/themes/**/*"
    ],
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": [
          "txt",
          "text"
        ],
        "name": "Plain Text",
        "description": "Plain text file",
        "role": "Editor"
      },
      {
        "ext": [
          "canvas"
        ],
        "name": "JSON Canvas",
        "description": "JSON Canvas document",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "endpoints": [
        "https://github.com/wizlijun/note.md/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNzc1QjQ2MkFDM0JGNDEKUldSQnY4TXFSbHQzekhuY0c1b1VGQzc2aHN2OXBjRHFNVHh1d2xGVWIwL0ZSalBIYk9XVnJteVIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
