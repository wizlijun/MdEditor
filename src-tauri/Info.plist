<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Markdown document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>net.daringfireball.markdown</string>
        <string>public.text</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>md</string>
        <string>markdown</string>
        <string>mdown</string>
        <string>mkd</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Plain text document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <!-- 刻意只登记纯文本:public.source-code / public.script 与那一长串代码
           扩展名会让 note.md 挤进每个 .py/.rs/.go 的「打开方式」里,对代码文件
           是打扰不是价值。要用 note.md 开代码文件,拖进窗口或「打开方式 →
           其他」仍然可以。 -->
      <key>LSItemContentTypes</key>
      <array>
        <string>public.plain-text</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>txt</string>
        <string>text</string>
      </array>
    </dict>
  </array>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- pos-log 插件：定位权限归因到宿主 app（插件进程 = 责任进程 note.md）。
       两个 key 都放以覆盖 macOS 版本差异。 -->
  <key>NSLocationUsageDescription</key>
  <string>note.md records your location to your vault when the Location Log plugin is enabled.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>note.md records your location to your vault when the Location Log plugin is enabled.</string>
</dict>
</plist>
