{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notemd.example/schemas/memory/protocol-revision-v2.json",
  "title": "NoteMD Memory v2 protocol revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision_id", "base_heads", "causal_context", "protocol_major", "protocol_minor", "renderer_version", "claim_schema", "category_registry", "decision", "transition", "payload_sha256"],
  "properties": {
    "schema": { "const": "notemd.memory/protocol-revision/v2" },
    "revision_id": { "$ref": "#/$defs/id" },
    "base_heads": { "type": "array", "items": { "$ref": "#/$defs/revisionRef" } },
    "causal_context": { "$ref": "#/$defs/causalContext" },
    "protocol_major": { "const": 2 },
    "protocol_minor": { "type": "integer", "minimum": 0 },
    "renderer_version": { "type": "string", "minLength": 1 },
    "claim_schema": { "const": "notemd.memory/claim-revision/v2" },
    "category_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "memory"],
      "properties": {
        "user": { "const": ["owner", "identity", "preferences", "work-style", "boundaries", "other"] },
        "memory": { "const": ["decisions", "constraints", "practices", "context", "other"] }
      }
    },
    "decision": { "$ref": "#/$defs/decision" },
    "transition": { "$ref": "#/$defs/transition" },
    "payload_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revisionRef": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_id", "payload_sha256"],
      "properties": { "revision_id": { "$ref": "#/$defs/id" }, "payload_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "recordRef": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "raw_sha256"],
      "properties": { "record_id": { "$ref": "#/$defs/id" }, "raw_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "causalContext": {
      "type": "object", "additionalProperties": false, "required": ["parents"],
      "properties": { "parents": { "type": "array", "items": { "$ref": "#/$defs/recordRef" } } }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "actor_id", "authority_context"],
      "properties": {
        "verdict": { "const": "approve" },
        "actor_id": { "$ref": "#/$defs/id" },
        "authority_context": {
          "type": "object", "additionalProperties": false,
          "required": ["heads", "capability"],
          "properties": {
            "heads": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/revisionRef" } },
            "capability": { "enum": ["memory.protocol.modify", "memory.protocol.resolve"] }
          }
        }
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["operation"],
      "properties": { "operation": { "enum": ["initialize", "replace", "resolve"] } }
    }
  }
}
