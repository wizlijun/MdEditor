{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notemd.example/schemas/memory/authority-revision-v2.json",
  "title": "NoteMD Memory v2 authority revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision_id", "base_heads", "causal_context", "owner", "principals", "recovery", "decision", "transition", "payload_sha256"],
  "properties": {
    "schema": { "const": "notemd.memory/authority-revision/v2" },
    "revision_id": { "$ref": "#/$defs/id" },
    "base_heads": { "type": "array", "items": { "$ref": "#/$defs/revisionRef" } },
    "causal_context": { "$ref": "#/$defs/causalContext" },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "actor_id"],
      "properties": { "owner_id": { "$ref": "#/$defs/id" }, "actor_id": { "type": "string", "pattern": "^human:.+" } }
    },
    "principals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["actor_id", "capabilities"],
        "properties": {
          "actor_id": { "$ref": "#/$defs/id" },
          "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": { "mode": { "enum": ["local-owner-setup", "bootstrap-recovery-proof"] } }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "actor_id", "authority_context"],
      "properties": {
        "verdict": { "const": "approve" },
        "actor_id": { "$ref": "#/$defs/id" },
        "authority_context": {
          "type": "object", "additionalProperties": false,
          "required": ["heads", "capability"],
          "properties": {
            "heads": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/revisionRef" } },
            "capability": { "enum": ["memory.authority.modify", "memory.authority.resolve"] }
          }
        }
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["operation"],
      "properties": { "operation": { "enum": ["initialize", "replace", "resolve"] } }
    },
    "payload_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revisionRef": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_id", "payload_sha256"],
      "properties": { "revision_id": { "$ref": "#/$defs/id" }, "payload_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "recordRef": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "raw_sha256"],
      "properties": { "record_id": { "$ref": "#/$defs/id" }, "raw_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "causalContext": {
      "type": "object", "additionalProperties": false, "required": ["parents"],
      "properties": { "parents": { "type": "array", "items": { "$ref": "#/$defs/recordRef" } } }
    }
  }
}
