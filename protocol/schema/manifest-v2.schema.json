{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManifestV2",
  "type": "object",
  "required": [
    "activation",
    "capabilities",
    "engines",
    "id",
    "kind",
    "manifest_version",
    "name",
    "version"
  ],
  "properties": {
    "activation": {
      "$ref": "#/definitions/Activation"
    },
    "binary": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contributes": {
      "default": {
        "cli": [],
        "context_menus": [],
        "custom_editors": [],
        "menus": [],
        "settings": null,
        "tray": [],
        "windows": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/Contributes"
        }
      ]
    },
    "description": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "engines": {
      "$ref": "#/definitions/Engines"
    },
    "i18n": {
      "default": null
    },
    "id": {
      "type": "string"
    },
    "idle_shutdown_seconds": {
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "kind": {
      "$ref": "#/definitions/PluginKind"
    },
    "manifest_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "name": {
      "type": "string"
    },
    "request_timeout_seconds": {
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "ui": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Activation": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Contributes": {
      "type": "object",
      "properties": {
        "cli": {
          "default": [],
          "type": "array",
          "items": true
        },
        "context_menus": {
          "default": [],
          "type": "array",
          "items": true
        },
        "custom_editors": {
          "default": [],
          "type": "array",
          "items": true
        },
        "menus": {
          "default": [],
          "type": "array",
          "items": true
        },
        "settings": {
          "default": null
        },
        "tray": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TrayContribution"
          }
        },
        "windows": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/WindowContribution"
          }
        }
      },
      "additionalProperties": false
    },
    "Engines": {
      "type": "object",
      "required": [
        "notemd"
      ],
      "properties": {
        "notemd": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "PluginKind": {
      "type": "string",
      "enum": [
        "native",
        "wasm"
      ]
    },
    "TrayContribution": {
      "description": "一个托盘启动项：宿主在菜单栏 tray 下拉里加一条,点击打开该插件的窗口。",
      "type": "object",
      "required": [
        "window"
      ],
      "properties": {
        "accelerator": {
          "description": "系统级全局快捷键，如 `\"Cmd+Ctrl+I\"`：宿主在启动时注册它，按下等同于点击 本托盘项；同时把它作为**显示用**加速键挂在托盘项右侧。\n\n语法同 tauri-plugin-global-shortcut（`Cmd`/`Ctrl`/`Alt`/`Shift` + 键名， 大小写与修饰键顺序都不敏感）。解析失败、或组合已被别的 app 占用，都只记 日志：托盘项本身照常可点，插件照常加载。",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "托盘项文案；缺省用插件本地化名称（manifest `name` + `i18n.<locale>.name`）。",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "description": "进托盘下拉的哪一组。目前只认 [`TRAY_SECTION_CAPTURE`]（顶部捕获组： 快速笔记/每日笔记那一组，本项排在每日笔记之后、第一条分隔线之前）； 缺省 = 默认组（第一条分隔线之后、\"显示主窗口\"下面）。\n\n刻意用 `Option<String>` 而不是 enum：这个字段是**开放取值**的，将来加一个 新组名不该让老宿主整份 manifest 解析失败（整个结构体是 `deny_unknown_fields`，一次解析失败 = 插件完全加载不出来）。宿主对不认识 的取值降级到默认组即可 —— 位置不理想，但插件仍然可用。",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "description": "要打开的窗口 id（须匹配某个 `contributes.windows[].id`）。",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WindowContribution": {
      "type": "object",
      "required": [
        "entry",
        "height",
        "id",
        "width"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "height": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "min_height": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min_width": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "open_command": {
          "description": "contributes.menus 中命中此 command 的菜单项 = 打开本窗口（不走 command.execute）。",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "singleton": {
          "default": true,
          "type": "boolean"
        },
        "title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    }
  }
}
