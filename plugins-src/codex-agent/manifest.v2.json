{
  "manifest_version": 2,
  "id": "notemd.codex-agent",
  "name": "Codex Agent",
  "version": "1.0.10",
  "kind": "native",
  "engines": {
    "notemd": ">=6.828.1"
  },
  "description": "Run Codex CLI headlessly against your vault: task templates live in .notemd/agent-tasks, stream live in a window, or fire detached from the CLI.",
  "binary": {
    "aarch64-apple-darwin": "bin/notemd-codex-agent",
    "x86_64-apple-darwin": "bin/notemd-codex-agent"
  },
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open",
      "onCommand:run",
      "onCommand:run-note",
      "onCommand:run-task",
      "onCommand:run-status",
      "onCommand:harness-status",
      "onCli:codex-agent"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "advance",
        "label": "Codex Agent…",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Codex Agent",
        "width": 900,
        "height": 640,
        "min_width": 640,
        "min_height": 420,
        "open_command": "open"
      }
    ],
    "cli": [
      {
        "subcommand": "codex-agent",
        "command": "run",
        "summary": "Run a Codex Agent task headlessly",
        "args": [
          {
            "name": "task",
            "type": "string",
            "required": true,
            "help": "Task id — a directory under .notemd/agent-tasks/"
          }
        ],
        "flags": [
          {
            "long": "--prompt",
            "short": "-p",
            "type": "string",
            "help": "Extra prompt appended to the task's own"
          }
        ]
      }
    ]
  },
  "i18n": {
    "zh": {
      "name": "Codex 智能体",
      "description": "在知识库中以无界面方式运行 Codex CLI：使用 `.notemd/agent-tasks` 中的任务模板，在窗口中实时查看执行过程，或通过 CLI 在后台启动。",
      "menus": {
        "open": "Codex 智能体…"
      }
    },
    "ja": {
      "name": "Codex エージェント",
      "description": "Vault 内で Codex CLI をヘッドレス実行します。`.notemd/agent-tasks` のタスクテンプレートを使い、ウィンドウで進行状況をリアルタイム表示するほか、CLI からバックグラウンド実行もできます。",
      "menus": {
        "open": "Codex エージェント…"
      }
    },
    "de": {
      "name": "Codex Agent",
      "description": "Codex CLI headless im Vault ausführen: mit Aufgabenvorlagen aus `.notemd/agent-tasks`, live in einem Fenster oder im Hintergrund über die CLI.",
      "menus": {
        "open": "Codex Agent…"
      }
    }
  },
  "capabilities": [
    "ui",
    "toast",
    "vault.read",
    "editor.open",
    "notify",
    "settings"
  ],
  "request_timeout_seconds": 300
}
