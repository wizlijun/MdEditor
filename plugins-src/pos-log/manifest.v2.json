{
  "manifest_version": 2,
  "id": "notemd.pos-log",
  "name": "Location Log",
  "version": "1.1.4",
  "kind": "native",
  "engines": {
    "notemd": ">=6.828.3"
  },
  "description": "Log your location (macOS system Location Services) to the vault: appends country-province-city + POI (with latitude/longitude at line end) to pos/YYYY-MM-DD-pos.md whenever the address changes (every 30 min or on demand)",
  "binary": {
    "aarch64-apple-darwin": "bin/notemd-pos-log",
    "x86_64-apple-darwin": "bin/notemd-pos-log"
  },
  "activation": {
    "events": [
      "onStartupFinished",
      "onCommand:save-now"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "capture",
        "label": "Location Log",
        "command": "save-now"
      }
    ]
  },
  "capabilities": [
    "location",
    "vault.read",
    "vault.write",
    "toast"
  ],
  "request_timeout_seconds": 30,
  "i18n": {
    "zh": {
      "name": "位置记录",
      "menus": {
        "save-now": "位置记录"
      }
    },
    "ja": {
      "name": "位置記録",
      "menus": {
        "save-now": "位置記録"
      }
    },
    "de": {
      "name": "Standortprotokoll",
      "menus": {
        "save-now": "Standortprotokoll"
      }
    }
  }
}
