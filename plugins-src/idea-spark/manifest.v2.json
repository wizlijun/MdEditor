{
  "manifest_version": 2,
  "id": "notemd.idea-spark",
  "name": "Idea Spark",
  "version": "1.3.7",
  "kind": "native",
  "engines": {
    "notemd": ">=6.828.3"
  },
  "description": "Capture a spark, then let an agent argue it into a next-step document.",
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "inspiration",
        "label": "Idea Spark",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Idea Spark",
        "width": 760,
        "height": 640,
        "min_width": 600,
        "min_height": 480,
        "open_command": "open"
      }
    ],
    "tray": [
      {
        "window": "main",
        "section": "capture",
        "accelerator": "Cmd+Ctrl+I"
      }
    ]
  },
  "capabilities": [
    "vault.read",
    "vault.write",
    "toast",
    "editor.open",
    "editor.kit",
    "agent"
  ],
  "i18n": {
    "zh": {
      "name": "奇思妙想",
      "description": "捕捉一闪而过的灵感，再让智能体将它推敲成一份明确下一步的文档。",
      "menus": {
        "open": "奇思妙想"
      }
    },
    "ja": {
      "name": "アイデアスパーク",
      "description": "ひらめきを書き留め、エージェントとの議論を通じて、次の一歩が明確なドキュメントへ育てます。",
      "menus": {
        "open": "アイデアスパーク"
      }
    },
    "de": {
      "name": "Ideenfunke",
      "description": "Einen Geistesblitz festhalten und ihn gemeinsam mit einem Agenten zu einem Dokument mit einem klaren nächsten Schritt ausarbeiten.",
      "menus": {
        "open": "Ideenfunke"
      }
    }
  }
}
