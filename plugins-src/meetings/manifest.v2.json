{
  "manifest_version": 2,
  "id": "notemd.meetings",
  "name": "Meetings",
  "version": "1.0.0",
  "kind": "native",
  "engines": {
    "notemd": ">=6.903.2"
  },
  "description": "Archive speaker-attributed, time-coded meeting transcripts in ssot/meetings and migrate existing Hemory conversations without copying audio.",
  "binary": {
    "aarch64-apple-darwin": "bin/notemd-meetings",
    "x86_64-apple-darwin": "bin/notemd-meetings"
  },
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open",
      "onCli:meetings-import-hemory"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "capture",
        "label": "Meetings…",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Meetings",
        "width": 920,
        "height": 680,
        "min_width": 680,
        "min_height": 500,
        "open_command": "open"
      }
    ],
    "cli": [
      {
        "subcommand": "meetings-import-hemory",
        "command": "import-hemory",
        "summary": "Migrate Hemory conversations into ssot/meetings",
        "args": [
          {
            "name": "source",
            "type": "path",
            "required": true,
            "help": "Hemory root, user root, or conversation(s) directory"
          }
        ],
        "flags": [
          {
            "long": "--full",
            "type": "boolean",
            "help": "Rescan and validate every discovered conversation"
          },
          {
            "long": "--dry-run",
            "type": "boolean",
            "help": "Plan the migration without writing to the vault"
          },
          {
            "long": "--user",
            "type": "string",
            "help": "Hemory user id (required when more than one is found)"
          },
          {
            "long": "--timezone",
            "type": "string",
            "help": "IANA timezone for historical timestamps without an offset"
          }
        ],
        "requires_tab_context": false
      }
    ]
  },
  "capabilities": [
    "ui",
    "toast",
    "dialog",
    "vault.read",
    "vault.write",
    "editor.open"
  ],
  "request_timeout_seconds": 300,
  "i18n": {
    "zh": {
      "name": "会议记录",
      "description": "将带说话人和时间码的会议逐字稿归档到 `ssot/meetings`，并在不复制音频的前提下迁移 Hemory 会话。",
      "menus": {
        "open": "会议记录…"
      }
    },
    "ja": {
      "name": "会議記録",
      "description": "話者とタイムコード付きの会議トランスクリプトを `ssot/meetings` に保存し、音声をコピーせずに Hemory の会話を移行します。",
      "menus": {
        "open": "会議記録…"
      }
    },
    "de": {
      "name": "Besprechungen",
      "description": "Sprecher- und zeitcodierte Besprechungstranskripte in `ssot/meetings` archivieren und Hemory-Unterhaltungen ohne Audiodateien migrieren.",
      "menus": {
        "open": "Besprechungen…"
      }
    }
  }
}
