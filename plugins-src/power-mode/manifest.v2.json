{
  "manifest_version": 2,
  "id": "notemd.power-mode",
  "name": "Power Mode",
  "version": "1.0.2",
  "kind": "native",
  "engines": { "notemd": ">=6.828.3" },
  "description": "Cursor explosions, a combo meter and a little screen shake while you type.",
  "ui": "ui/",
  "activation": { "events": ["onCommand:open"] },
  "contributes": {
    "menus": [
      { "location": "plugins", "submenu": "create", "label": "Power Mode", "command": "open" }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Power Mode",
        "width": 620,
        "height": 760,
        "min_width": 520,
        "min_height": 600,
        "open_command": "open"
      }
    ]
  },
  "capabilities": ["editor.kit", "power-mode"],
  "i18n": {
    "zh": { "name": "狂暴模式", "description": "输入时呈现光标爆炸、连击计数和轻微屏幕震动效果。", "menus": { "open": "狂暴模式" } },
    "ja": { "name": "パワーモード", "description": "入力に合わせてカーソルの爆発エフェクト、コンボメーター、軽い画面揺れを表示します。", "menus": { "open": "パワーモード" } },
    "de": { "name": "Power-Modus", "description": "Cursor-Explosionen, Combo-Anzeige und dezentes Bildschirmwackeln beim Tippen.", "menus": { "open": "Power-Modus" } }
  }
}
