{
  "manifest_version": 2,
  "id": "notemd.roam-import",
  "name": "Roam Research Import",
  "version": "1.2.1",
  "kind": "native",
  "binary": {
    "aarch64-apple-darwin": "bin/notemd-roam-import",
    "x86_64-apple-darwin": "bin/notemd-roam-import"
  },
  "engines": {
    "notemd": ">=6.808.2"
  },
  "description": "Import a Roam Research JSON export into the vault as .note.md outline pages and daily notes",
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open",
      "onCli:roam-day",
      "onCli:roam-sync"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "file",
        "label": "Import from Roam Research…",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Import from Roam Research",
        "width": 680,
        "height": 620,
        "min_width": 520,
        "min_height": 420,
        "open_command": "open"
      }
    ],
    "cli": [
      {
        "subcommand": "roam-day",
        "command": "sync-day",
        "summary": "Sync one day's Roam daily note into the vault",
        "args": [],
        "flags": [
          { "long": "--date", "type": "string", "help": "yyyy-MM-dd, today or yesterday (default: yesterday)" },
          { "long": "--graph", "type": "string", "help": "Roam graph name (default: the CLI's own default)" }
        ],
        "requires_tab_context": false
      },
      {
        "subcommand": "roam-sync",
        "command": "sync-changed",
        "summary": "Sync every Roam page changed since the last sync",
        "args": [],
        "flags": [
          { "long": "--since", "type": "string", "help": "Override the stored watermark (yyyy-MM-dd)" },
          { "long": "--graph", "type": "string", "help": "Roam graph name (default: the CLI's own default)" },
          { "long": "--dry-run", "type": "boolean", "help": "List what would be synced without writing" }
        ],
        "requires_tab_context": false
      }
    ]
  },
  "capabilities": [
    "dialog",
    "vault.read",
    "vault.write",
    "fs.read:dialog",
    "clipboard.write",
    "toast",
    "ui"
  ],
  "request_timeout_seconds": 120,
  "i18n": {
    "zh": {
      "name": "Roam Research 导入",
      "menus": {
        "open": "从 Roam Research 导入…"
      }
    },
    "ja": {
      "name": "Roam Research インポート",
      "menus": {
        "open": "Roam Research からインポート…"
      }
    },
    "de": {
      "name": "Roam-Research-Import",
      "menus": {
        "open": "Aus Roam Research importieren…"
      }
    }
  }
}
