{
  "manifest_version": 2,
  "id": "notemd.decision-log",
  "name": "Decision",
  "version": "1.1.6",
  "kind": "native",
  "engines": {
    "notemd": ">=6.828.3"
  },
  "description": "Predict before, judge after — a calibrated decision journal stored as .note.md.",
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "window",
        "submenu": "reflect",
        "label": "Decision",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Decision",
        "width": 920,
        "height": 680,
        "min_width": 720,
        "min_height": 480,
        "open_command": "open"
      }
    ],
    "tray": [
      {
        "window": "main"
      }
    ]
  },
  "capabilities": [
    "vault.read",
    "vault.write",
    "toast"
  ],
  "i18n": {
    "zh": {
      "name": "决策",
      "description": "先预测，后复盘——以 `.note.md` 格式保存的校准型决策记录。",
      "menus": {
        "open": "决策"
      }
    },
    "ja": {
      "name": "意思決定",
      "description": "先に予測し、後から判断を検証するための意思決定ジャーナルです。記録は `.note.md` 形式で保存されます。",
      "menus": {
        "open": "意思決定"
      }
    },
    "de": {
      "name": "Entscheidung",
      "description": "Erst prognostizieren, später bewerten – ein kalibriertes Entscheidungsjournal im `.note.md`-Format.",
      "menus": {
        "open": "Entscheidung"
      }
    }
  }
}
