{
  "manifest_version": 2,
  "id": "notemd.next",
  "name": "Next",
  "version": "1.4.1",
  "kind": "native",
  "engines": {
    "notemd": ">=6.901.1"
  },
  "description": "Give every idea a next step — or a place to rest.",
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "advance",
        "label": "Next",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Next",
        "width": 1240,
        "height": 760,
        "min_width": 720,
        "min_height": 520,
        "open_command": "open"
      }
    ],
    "tray": [
      {
        "window": "main",
        "section": "capture",
        "accelerator": "Cmd+Ctrl+N"
      }
    ]
  },
  "capabilities": [
    "vault.read",
    "vault.write",
    "editor.open",
    "toast"
  ],
  "i18n": {
    "zh": {
      "name": "下一步",
      "description": "让每个想法都有明确的下一步，或一个安心搁置的地方。",
      "menus": {
        "open": "下一步"
      }
    },
    "ja": {
      "name": "次の一歩",
      "description": "すべてのアイデアに次の一歩を与えるか、安心して休ませる場所を用意します。",
      "menus": {
        "open": "次の一歩"
      }
    },
    "de": {
      "name": "Nächster Schritt",
      "description": "Jeder Idee einen nächsten Schritt geben – oder einen guten Ort, an dem sie ruhen kann.",
      "menus": {
        "open": "Nächster Schritt"
      }
    }
  }
}
